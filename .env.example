# Copy to .env and edit. Every value here is already the compose default —
# uncomment only what you want to change.

# --- image ---
# Default is the validated nightly. `nightly` tracks upstream; the build fails
# if the SM86 patch no longer matches the vLLM source.
#VLLM_VERSION=nightly-f2f9edcac30d128bc090a3c032e4ba125716a641
# 1 = apply inkling_sm86_patch.py (required on RTX 3090 / any pre-Hopper GPU).
#INKLING_SM86_PATCH=1

# --- host identity / caches ---
# Set these to `id -u` / `id -g` if you are not uid/gid 1000.
#DOCKER_UID=1000
#DOCKER_GID=1000
#HF_CACHE_DIR=${HOME}/.cache/huggingface
#HUGGING_FACE_HUB_TOKEN=
#CONTAINER_NAME=inkling-2-mini

# --- GPUs ---
#CUDA_VISIBLE_DEVICES=0,1
#NCCL_P2P_LEVEL=NVL

# --- model ---
#MODEL=thinkingmachines/Inkling-2-Mini
#SERVED_MODEL_NAMES=Inkling-2-Mini inkling-2-mini thinkingmachines/Inkling-2-Mini

# --- serving tunables (see results/RESULTS.md) ---
#MAX_MODEL_LEN=262144
# 64 = +18% aggregate throughput, ~22 tok/s per stream
#MAX_NUM_SEQS=32
# 2048 (vLLM's default) does not leave room for one 262144-token request
#MAX_NUM_BATCHED_TOKENS=1024
# BF16; the only option off Blackwell
#KV_CACHE_DTYPE=auto
# empty = vLLM sizes the KV cache from what is free after warmup
#GPU_MEM_UTIL=
#TENSOR_PARALLEL_SIZE=2
# DSpark speculation: 7 or 0 (off) only
#SPEC_TOKENS=7
#SPEC_DRAFT_SAMPLE=probabilistic
#LONG_PREFILL_THRESHOLD=32768
#ENABLE_PREFIX_CACHING=1
# extra `vllm serve` flags, whitespace-split
#EXTRA_ARGS=
